# Branding

# App display name (header, metadata, PWA, OG)
APPLICATION_NAME=Better Auth Server

# Optional theme (OKLCH). Leave blank for defaults.
NEXT_PUBLIC_PRIMARY_HUE=
NEXT_PUBLIC_PRIMARY_CHROMA=

# Optional CDN asset URLs
FAVICON_URL=
ICON_URL=
OPENGRAPH_IMAGE_URL=
# Header logo; when set, replaces APPLICATION_NAME text
LOGO_URL=

# Set to "true" to show the GitHub icon in the header (hidden by default)
NEXT_PUBLIC_SHOW_GITHUB=

# Set to "true" to enable the in-app docs site at /docs/framework (off by default)
NEXT_PUBLIC_DOCS_ENABLED=

# Set to "true" to enable Better Auth organizations (members, invites, /organization/*)
NEXT_PUBLIC_ORGANIZATIONS_ENABLED=

# Set to "true" to require a better-invite link for new sign-ups (first user can still bootstrap)
NEXT_PUBLIC_INVITE_ONLY=

# --- Better Auth (required) ---
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated extra trusted origins (BETTER_AUTH_URL is always included)
BETTER_AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_SECRET=
BETTER_AUTH_API_KEY=
BETTER_AUTH_IDENTIFY_URL=

# --- Database (required) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/better_auth

# --- OAuth / OIDC (optional overrides; default to BETTER_AUTH_URL) ---
OAUTH_ISSUER=
# Protected resource identifier (JWT aud). Defaults to BETTER_AUTH_URL.
OAUTH_AUDIENCE=

# Dynamic client registration (RFC 7591). Set to "true" to enable.
ALLOW_DYNAMIC_CLIENT_REGISTRATION=
# Allow public clients to register without a session (e.g. MCP). Defaults off.
ALLOW_UNAUTHENTICATED_CLIENT_REGISTRATION=

# --- Email (optional) ---
# Prefer SMTP_* when set; otherwise Better Auth Infra (BETTER_AUTH_API_KEY); else console.
# Resend (recommended): SMTP_HOST=smtp.resend.com + SMTP_PASS=re_… — sent via HTTPS API
# (SMTP 587/465 often times out). Other providers use nodemailer on SMTP_PORT.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Analytics (optional — omit key to disable PostHog) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
