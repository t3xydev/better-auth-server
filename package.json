{
    "name": "better-auth-server",
    "version": "0.1.0",
    "private": true,
    "description": "Own OpenID / OAuth identity server on Better Auth — extend the full app or run accounts-style; Nostr ready; Bluesky, wallets, billing planned",
    "scripts": {
        "dev": "pnpm db:migrate && next dev --turbopack",
        "build": "next build",
        "start": "pnpm db:migrate && next start",
        "postinstall": "fumadocs-mdx",
        "lint": "biome check",
        "format": "biome format --write",
        "check-types": "tsc --noEmit",
        "db:auth": "AUTH_GENERATE=1 auth generate -y --adapter drizzle --dialect postgresql && node scripts/pluralize-auth-schema.mjs",
        "db:gen": "npx drizzle-kit generate",
        "db:migrate": "node scripts/db-migrate.mjs",
        "db:sync": "pnpm db:auth && pnpm db:gen && pnpm db:migrate",
        "deploy:sync": "tsx deploy/sync.ts",
        "cf:deploy": "wrangler deploy",
        "cf:preview": "wrangler dev"
    },
    "dependencies": {
        "@better-auth/drizzle-adapter": "^1.7.4",
        "@better-auth/infra": "^0.4.9",
        "@better-auth/oauth-provider": "^1.7.4",
        "@better-auth/passkey": "^1.7.4",
        "@daveyplate/better-auth-ui": "^3.4.0",
        "@dbsc-toolkit/better-auth": "^1.2.2",
        "@hookform/resolvers": "^5.5.7",
        "@modelcontextprotocol/sdk": "1.26.0",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-slot": "^1.2.3",
        "@types/mdx": "^2.0.14",
        "better-auth": "^1.7.4",
        "better-auth-devtools": "^1.0.1",
        "better-auth-nostr": "^0.2.0",
        "better-invite": "^0.5.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dbsc-toolkit": "^2.14.1",
        "drizzle-orm": "^0.45.2",
        "fumadocs-core": "15.8.5",
        "fumadocs-mdx": "11.10.1",
        "fumadocs-ui": "15.8.5",
        "lucide-react": "^0.544.0",
        "mcp-handler": "^1.1.0",
        "next": "15.5.14",
        "next-themes": "0.4.6",
        "nodemailer": "^9.0.1",
        "nostr-tools": "^2.23.8",
        "pg": "^8.16.3",
        "posthog-js": "^1.364.7",
        "radix-ui": "^1.4.3",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-hook-form": "^7.56.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.3.1",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@biomejs/biome": "2.2.4",
        "@cloudflare/containers": "^0.3.7",
        "@tailwindcss/postcss": "^4.1.13",
        "@types/node": "^24.5.2",
        "@types/nodemailer": "^8.0.1",
        "@types/pg": "^8.15.5",
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.9",
        "auth": "^1.7.4",
        "dotenv": "^17.2.2",
        "drizzle-kit": "^0.31.4",
        "esbuild": "^0.25.10",
        "railway": "3.11.0",
        "tailwindcss": "^4.1.13",
        "tailwindcss-safe-area": "^1.1.0",
        "tsx": "^4.23.5",
        "turbo": "^2.5.7",
        "tw-animate-css": "^1.3.8",
        "typescript": "^5.9.2",
        "wrangler": "^4.131.0"
    },
    "pnpm": {
        "overrides": {},
        "patchedDependencies": {
            "better-invite@0.5.0": "patches/better-invite@0.5.0.patch",
            "better-auth@1.7.4": "patches/better-auth@1.7.4.patch"
        }
    },
    "packageManager": "pnpm@10.12.1"
}
